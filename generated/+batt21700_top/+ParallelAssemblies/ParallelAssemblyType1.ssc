component ParallelAssemblyType1
    % ParallelAssemblyType1:2
    % Parallel Assembly Block
    %    Model resolution: Detailed
    %    Number of cells: 2
    %
    %
    %    Inter-cell heat transfer: on
    %    Inter-cell radiation heat transfer: on
    %    Number of inter-cell thermal connections: 1
    %
    %    MATLAB version: 25.2
    %    Simscape Battery version: 25.2
    %    Simscape code generated on: 22-Sep-2026 07:48:31

    parameters
        SOC_vecCell = {[0, .1, .25, .5, .75, .9, 1],'1'}; % Vector of state-of-charge values, SOC
        T_vecCell = {[278, 293, 313],'K'}; % Vector of temperatures, T
        V0_matCell = {[3.49, 3.5, 3.51; 3.55, 3.57, 3.56; 3.62, 3.63, 3.64; 3.71, 3.71, 3.72; 3.91, 3.93, 3.94; 4.07, 4.08, 4.08; 4.19, 4.19, 4.19],'V'}; % Open-circuit voltage, V0(SOC,T)
        V_rangeCell = {[0, inf],'V'}; % Terminal voltage operating range [Min Max]
        R0_matCell = {[.0117, .0085, .009; .011, .0085, .009; .0114, .0087, .0092; .0107, .0082, .0088; .0107, .0083, .0091; .0113, .0085, .0089; .0116, .0085, .0089],'Ohm'}; % Terminal resistance, R0(SOC,T)
        AHCell = {27,'A*hr'}; % Cell capacity, AH
        extrapolation_optionCell = {simscape.enum.extrapolation.nearest,'1'}; % Extrapolation method for all tables
        thermal_massCell = {100,'J/K'}; % Thermal mass
        AmbientResistance = {25,'K/W'}; % Cell level ambient thermal path resistance
        XmaxThermalResistance = {25,'K/W'}; % Cell-level thermal path resistance at Xmax boundary
        InterCellThermalResistance = {1,'K/W'}; % Inter-cell thermal path resistance
        InterCellRadiationArea = {1e-3,'m^2'}; % Inter-cell radiation heat transfer area
        InterCellRadiationCoefficient = {1e-6,'W/(K^4*m^2)'}; % Inter-cell radiation heat transfer coefficient
    end

    parameters(ExternalAccess=none)
        P = 2; % Batteries in Parallel
        NumInterCellThermalConnections = 1; % Number of inter-cell thermal connections
        InterCellConnectionsMapping = [1;2]; % Cell model to neighbors mapping
        NumXmaxConnections = 1; % Number of thermal connections at Xmax boundary
        XmaxConnectionsMapping = 2; % Cell models at Xmax boundary with thermal connections
        NumCellsAtXmaxBoundary = 1; % Number of cells at Xmax boundary
        NumCellThermalNodeElements = size(Cell21700(1).H,1); % NumCellThermalNodeElements
    end

    parameters(Access=private)
        AmbientResistanceScaled = AmbientResistance .* ones(NumCellThermalNodeElements,P) * NumCellThermalNodeElements / size(AmbientResistance,1); % Scaled cell level ambient thermal path resistance
        XmaxThermalResistanceScaled = XmaxThermalResistance .* ones(1,NumXmaxConnections) * NumCellThermalNodeElements; % Scaled cell-level thermal path resistance at Xmax boundary
        InterCellRadiationAreaScaled = InterCellRadiationArea .* ones(NumCellThermalNodeElements,NumInterCellThermalConnections) * size(InterCellRadiationArea,1) / NumCellThermalNodeElements; % Scaled inter-cell radiation heat transfer area
        InterCellRadiationCoefficientScaled = InterCellRadiationCoefficient .* ones(NumCellThermalNodeElements,NumInterCellThermalConnections); % Scaled inter-cell radiation heat transfer coefficient
        InterCellThermalResistanceScaled = InterCellThermalResistance .* ones(NumCellThermalNodeElements,NumInterCellThermalConnections) * NumCellThermalNodeElements / size(InterCellThermalResistance,1); % Scaled inter-cell thermal path resistance
    end

    nodes
        p = foundation.electrical.electrical; % +
        n = foundation.electrical.electrical; % -
        AmbH = foundation.thermal.thermal; % AmbH
        XmaxH = repmat(foundation.thermal.thermal,1,NumXmaxConnections); % XmaxH
        InterCellH = repmat(foundation.thermal.thermal,NumCellThermalNodeElements,P); % ICH
        InterCellRadiativeH = repmat(foundation.thermal.thermal,NumCellThermalNodeElements,P); % ICRH
    end

    variables
        iCell = {repmat(0,2,1),'A'}; % Cell current (positive in)
        vCell = {repmat(0,2,1),'V'}; % Cell terminal voltage
        socCell = {value={repmat(1,2,1),'1'},priority=priority.high}; % Cell state of charge
        numCyclesCell = {value={repmat(0,2,1),'1'},priority=priority.high}; % Cell discharge cycles
        temperatureCell = {value={repmat(298.15,2,1),'K'},priority=priority.high}; % Cell temperature
        vParallelAssembly = {value={0,'V'},priority=priority.none}; % Parallel Assembly Voltage
        socParallelAssembly = {value={1,'1'},priority=priority.none}; % Parallel Assembly state of charge
    end

    equations
        assert(length(iCell) == P);
        assert(length(vCell) == P);
        assert(length(socCell) == P);
        assert(length(numCyclesCell) == P);
        assert(length(temperatureCell) == P);
        assert(length(vParallelAssembly) == 1);
        assert(length(socParallelAssembly) == 1);
        assert(isequal(size(AmbientResistance),[1,1]) || isequal(size(AmbientResistance),[NumCellThermalNodeElements,P]),...
            'Cell level ambient thermal path resistance must be scalar or an M-by-N array, where M is the number of elements of the cell thermal node and N is number of cells modeled by the block.');
        assert(isequal(size(XmaxThermalResistance),[1,1]) || isequal(size(XmaxThermalResistance),[1,NumXmaxConnections]),...
            'Cell-level thermal path resistance at Xmax boundary must be scalar or row vector. Set the size of this vector to number of Xmax thermal connections modeled by the block.');
        assert(isequal(size(InterCellRadiationArea),[1,1]) || isequal(size(InterCellRadiationArea),[NumCellThermalNodeElements,NumInterCellThermalConnections]),...
            'Inter-cell radiation heat transfer area must be scalar or an M-by-N array, where M is the number of elements of the cell thermal node and N is number of inter-cell thermal connections modeled by the block.');
        assert(isequal(size(InterCellRadiationCoefficient),[1,1]) || isequal(size(InterCellRadiationCoefficient),[NumCellThermalNodeElements,NumInterCellThermalConnections]),...
            'Inter-cell radiation heat transfer coefficient must be scalar or an M-by-N array, where M is the number of elements of the cell thermal node and N is number of inter-cell thermal connections modeled by the block.');
        assert(isequal(size(InterCellThermalResistance),[1,1]) || isequal(size(InterCellThermalResistance),[NumCellThermalNodeElements,NumInterCellThermalConnections]),...
            'Inter-cell thermal path resistance must be scalar or an M-by-N array, where M is the number of elements of the cell thermal node and N is number of inter-cell thermal connections modeled by the block.');
        vParallelAssembly == Cell21700(1).p.v - Cell21700(1).n.v;
        socParallelAssembly == sum([Cell21700.stateOfCharge])/P;
    end

    annotations
        [p] : Side=top;
        [n] : Side=bottom;
        [XmaxH] : Side=right;
        [InterCellH] : Side=bottom;
        [InterCellRadiativeH] : Side=bottom;
        UILayout = [UIGroup("Main",SOC_vecCell,T_vecCell,V0_matCell,V_rangeCell,R0_matCell,AHCell,extrapolation_optionCell),...
            UIGroup("Thermal",thermal_massCell,AmbientResistance,XmaxThermalResistance,InterCellThermalResistance,InterCellRadiationArea,InterCellRadiationCoefficient)];
        Icon = 'parallelAssembly.svg';
    end

    for Pidx = 1:P
        components(ExternalAccess=observe,CompileReuse=true)
            Cell21700(Pidx) = batteryecm.table_battery(SOC_vec = SOC_vecCell,...
                T_vec = T_vecCell,V0_mat = V0_matCell,V_range = V_rangeCell,R0_mat = R0_matCell,...
                AH = AHCell,extrapolation_option = extrapolation_optionCell,...
                thermal_mass = thermal_massCell,SOC_port = simscape.enum.tablebattery.enable.no,...
                T_dependence = simscape.enum.tablebattery.temperature_dependence.yes,...
                prm_age_OCV = simscape.enum.tablebattery.prm_age_OCV.OCV,...
                prm_age_capacity = simscape.enum.tablebattery.prm_age.disabled,...
                prm_age_modeling = simscape.enum.tablebattery.prm_age_modeling.equation,...
                prm_age_resistance = simscape.enum.tablebattery.prm_age.disabled,...
                prm_dir = simscape.enum.tablebattery.prm_dir.noCurrentDirectionality,...
                prm_dyn = simscape.enum.tablebattery.prm_dyn.off,prm_fade = simscape.enum.tablebattery.prm_fade.disabled,...
                prm_leak = simscape.enum.tablebattery.prm_leak.disabled,...
                thermal_port = simscape.enum.thermaleffects.model,i.priority = priority.none,...
                v.priority = priority.none,stateOfCharge.priority = priority.none,...
                num_cycles.priority = priority.none,cell_temperature.priority = priority.none);
        end
    end

    for Pidx = 1:P
        connections
            connect(p,Cell21700(Pidx).p);
            connect(Cell21700(Pidx).n,n);
        end
    end

    for Pidx = 1:P
        equations
            Cell21700(Pidx).i == iCell(Pidx);
            Cell21700(Pidx).v == vCell(Pidx);
            Cell21700(Pidx).stateOfCharge == socCell(Pidx);
            Cell21700(Pidx).num_cycles == numCyclesCell(Pidx);
            Cell21700(Pidx).cell_temperature == temperatureCell(Pidx);
        end
    end

    for thermalNodeElementIdx = 1:NumCellThermalNodeElements
        for Pidx = 1:P
            components(ExternalAccess=observe)
                AmbientResistor(thermalNodeElementIdx,Pidx) = foundation.thermal.elements.resistance(...
                    resistance = AmbientResistanceScaled(thermalNodeElementIdx,Pidx));
            end

            connections
                connect(Cell21700(Pidx).H(thermalNodeElementIdx),AmbientResistor(thermalNodeElementIdx,Pidx).A);
                connect(AmbientResistor(thermalNodeElementIdx,Pidx).B,AmbH);
            end
        end
    end

    for thermalNodeElementIdx = 1:NumCellThermalNodeElements
        for cellsAtXmaxIdx = 1:NumXmaxConnections
            components(ExternalAccess=observe)
                XmaxThermalResistor(thermalNodeElementIdx,cellsAtXmaxIdx) = foundation.thermal.elements.resistance(...
                    resistance = XmaxThermalResistanceScaled(cellsAtXmaxIdx));
            end
        end

        for cellsAtXmaxIdx = XmaxConnectionsMapping
            connections
                connect(Cell21700(cellsAtXmaxIdx).H(thermalNodeElementIdx),XmaxThermalResistor(thermalNodeElementIdx,find(XmaxConnectionsMapping==cellsAtXmaxIdx)).A);
                connect(XmaxThermalResistor(thermalNodeElementIdx,find(XmaxConnectionsMapping==cellsAtXmaxIdx)).B,XmaxH(:,find(XmaxConnectionsMapping==cellsAtXmaxIdx)));
            end
        end
    end

    for NodeElementIndex = 1:NumCellThermalNodeElements
        for InterCellConnectionIndex = 1:NumInterCellThermalConnections
            components(ExternalAccess=observe)
                InterCellThermalResistor(NodeElementIndex,InterCellConnectionIndex) = foundation.thermal.elements.resistance(...
                    resistance = InterCellThermalResistanceScaled(NodeElementIndex,InterCellConnectionIndex));
            end

            connections
                connect(Cell21700(InterCellConnectionsMapping(1,InterCellConnectionIndex)).H(NodeElementIndex),InterCellThermalResistor(NodeElementIndex,InterCellConnectionIndex).A);
                connect(InterCellThermalResistor(NodeElementIndex,InterCellConnectionIndex).B,Cell21700(InterCellConnectionsMapping(2,InterCellConnectionIndex)).H(NodeElementIndex));
            end
        end

        for Pidx = 1:P
            connections
                connect(Cell21700(Pidx).H(NodeElementIndex),InterCellH(NodeElementIndex,Pidx));
            end
        end
    end

    for NodeElementIndex = 1:NumCellThermalNodeElements
        for InterCellConnectionIndex = 1:NumInterCellThermalConnections
            components(ExternalAccess=observe)
                InterCellRadiativeHeatTransfer(NodeElementIndex,InterCellConnectionIndex) = foundation.thermal.elements.radiation(...
                    area = InterCellRadiationAreaScaled(NodeElementIndex,InterCellConnectionIndex),...
                    rad_tr_coeff = InterCellRadiationCoefficientScaled(NodeElementIndex,InterCellConnectionIndex));
            end

            connections
                connect(Cell21700(InterCellConnectionsMapping(1,InterCellConnectionIndex)).H(NodeElementIndex),InterCellRadiativeHeatTransfer(NodeElementIndex,InterCellConnectionIndex).A);
                connect(InterCellRadiativeHeatTransfer(NodeElementIndex,InterCellConnectionIndex).B,Cell21700(InterCellConnectionsMapping(2,InterCellConnectionIndex)).H(NodeElementIndex));
            end
        end

        for Pidx = 1:P
            connections
                connect(Cell21700(Pidx).H(NodeElementIndex),InterCellRadiativeH(NodeElementIndex,Pidx));
            end
        end
    end
end